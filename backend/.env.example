# ============================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================
# Скопируй этот файл в .env и измени значения для продакшена

# База данных
DATABASE_URL=sqlite:///./sks_quest.db
# Для PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/sks_quest

# JWT секретный ключ
SECRET_KEY=super-secret-key-change-in-production

# Redis (для кеша и rate-limit)
REDIS_URL=redis://localhost:6379/0
